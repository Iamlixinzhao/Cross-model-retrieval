{
  "mode": "clip",
  "manifest": "data/quick.jsonl",
  "clip_name": "openai/clip-vit-base-patch32",
  "unfreeze_last_n": 1,
  "gradient_checkpointing": false,
  "objective": "pcme",
  "dim": 128,
  "hidden": 128,
  "initial_sigma": 0.05,
  "batch_size": 8,
  "captions_per_media": 2,
  "train_samples": 4,
  "eval_samples": 8,
  "eval_batch_size": 8,
  "pair_chunk": 64,
  "pair_reduction": "balanced",
  "sigmoid_factor": 1.0,
  "kl_beta": 0.0001,
  "uniform_weight": 0.0,
  "lr": 0.0002,
  "backbone_lr": 0.000001,
  "weight_decay": 0.0,
  "epochs": 15,
  "amp": "bf16",
  "grad_clip": 2.0,
  "workers": 2,
  "seed": 17,
  "max_eval_pairs": 1000000
}
