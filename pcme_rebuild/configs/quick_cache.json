{
  "mode": "cache",
  "train_cache": "data/quick/train.pt",
  "val_cache": "data/quick/val.pt",
  "test_cache": "data/quick/test.pt",
  "objective": "pcme",
  "dim": 128,
  "hidden": 128,
  "initial_sigma": 0.05,
  "batch_size": 16,
